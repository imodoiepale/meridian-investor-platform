# === Claude agentic harness (required) ===
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# === Automations microservice (Node/Playwright, :5000) ===
AUTOMATIONS_URL=http://localhost:5000
# eFNS immigration portal credentials (live demo)
EFNS_EMAIL=
EFNS_ID_NUMBER=
EFNS_PASSWORD=
HEADLESS=false
AUTO_CLOSE=false
SLOW_MO=100

# === Optional ===
RESEND_API_KEY=            # emailed park invoices; invoices saved locally if empty
OPENAI_API_KEY=            # voice panel (Kesi) only
QDRANT_MODE=memory
MEMORY_BACKEND=json        # set to 'graphiti' once FalkorDB/Neo4j is available
PORT_BACKEND=5001

# --- Supabase (optional — enables persistent investor sessions across deploys) ---
NEXT_PUBLIC_SUPABASE_URL=https://habbcaxtqqiuvryakmot.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Switch to: MEMORY_BACKEND=supabase  to use Supabase instead of local JSON
