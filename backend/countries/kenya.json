  "market_gaps": {
    "agritech": "Post-harvest losses run 30-40%; cold-chain, storage-as-a-service and export aggregation are underserved outside Nairobi. Best counties: Nakuru, Kiambu, Meru.",
    "fintech": "SME credit gap est. USD 19B; embedded finance for agriculture and logistics under-penetrated. Nairobi dominant but licensing is national.",
    "manufacturing": "Import substitution demand in packaging, construction materials, agro-processing. Athi River (Machakos) SEZ offers tax holidays.",
    "tourism": "High-end eco-lodges and domestic-tourism digital packages underserved; coastal circuit (Mombasa/Kilifi) recovering faster than supply.",
    "healthcare": "Diagnostics and specialist outpatient chains scarce outside Nairobi; SHA reforms opening insured patient volumes in secondary counties.",
    "retail": "Tier-2 county formal retail penetration <30%; last-mile distribution and franchise models have open runway in Nakuru, Eldoret, Kisumu."
